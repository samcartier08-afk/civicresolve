GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection (local or MongoDB Atlas cloud URL)
MONGODB_URI=mongodb://127.0.0.1:27017/civicresolve
MONGODB_DB_NAME=civicresolve

