# ============================================================================
# CivicResolve Environment Configuration (.env.example)
# ============================================================================

# 1. Google Gemini & Vertex AI Embeddings
# Get your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-4-argon
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional Vertex AI Multimodal Embedding configuration
# (Falls back to Gemini image caption embedded as text when unset)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
VERTEX_AI_LOCATION=asia-south1

# 2. Google Maps Geocoding/Places & Cloud Translation APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_cloud_translation_api_key_here

# 3. Google Cloud Storage & Firebase Authentication
GCS_BUCKET_NAME=civicresolve-evidence
FIREBASE_PROJECT_ID=civicresolve-india

# 4. PostgreSQL (PostGIS + pgvector) & MongoDB Persistence
DATABASE_URL=postgresql+asyncpg://civic:civic@localhost:5432/civicresolve
MONGODB_URI=mongodb://127.0.0.1:27017/civicresolve
MONGODB_DB_NAME=civicresolve

# 5. Configurable IGMER Matching Weights & Thresholds
MATCH_WEIGHT_LOCATION=35.0
MATCH_WEIGHT_TEXT=30.0
MATCH_WEIGHT_IMAGE=20.0
MATCH_WEIGHT_CATEGORY=10.0
MATCH_WEIGHT_TIME=5.0
MATCH_THRESHOLD_HIGH=0.75
MATCH_THRESHOLD_MEDIUM=0.50
CANDIDATE_RADIUS_METERS=500.0
CANDIDATE_TIME_WINDOW_HOURS=168
MAX_WORKER_RETRIES=5
